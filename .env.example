# CRISP - Environment Configuration
# Copy to .env and fill in. Everything works out of the box locally;
# only FLASK_SECRET_KEY is strictly required for a real deployment.

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------
# Signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The app REFUSES to start in production without this.
FLASK_SECRET_KEY=

# Set to "production" to enable secure cookies (HTTPS-only) and enforce
# the secret-key requirement above.
CRISP_ENV=development

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite database location. On an ephemeral host (e.g. a free-tier
# container) point this at a mounted volume if you need data to survive
# restarts.
CRISP_DB_PATH=data/crisp.db

# ---------------------------------------------------------------------------
# Demo access
# ---------------------------------------------------------------------------
# Seeds two real accounts and shows the one-click demo buttons on the
# sign-in page. Set to false for a deployment holding real project data.
ALLOW_DEMO_LOGIN=true
DEMO_EXPERT_EMAIL=demo.expert@crisp.local
DEMO_EXPERT_PASSWORD=crisp-demo-expert
DEMO_WORKER_EMAIL=demo.worker@crisp.local
DEMO_WORKER_PASSWORD=crisp-demo-worker

# ---------------------------------------------------------------------------
# Optional: AI photo descriptions
# ---------------------------------------------------------------------------
# CRISP writes a description for every validated photo. With nothing set
# below it uses a built-in offline generator: no API key, no account, no
# network. The options here only substitute a vision model for it.
#
# Tier 1 wins if set, then Tier 2, then the offline generator. Each tier
# falls through to the next on timeout or error.

# OpenAI-compatible endpoint (Ollama, Groq, OmniRoute, and so on)
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
AI_GATEWAY_MODEL=gpt-4o-mini

# --- Tier 2: Google Gemini -------------------------------------------------
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------
APP_TIMEZONE=UTC
FLASK_DEBUG=false
